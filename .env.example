# Generate a random token and replace the empty object with {"tenant-id":"token"}.
SOVEREIGN_TENANT_TOKENS={}
SOVEREIGN_DB_PATH=sovereign_maas.sqlite3
# Optional: absolute path to locally trained and checked Phase 2 model artifacts.
# SOVEREIGN_MODEL_DIR=results/phase2-v1

# Optional separate human approver credentials. Never reuse tenant operator tokens.
SOVEREIGN_APPROVER_TOKENS={}

# Optional Prometheus scrape credential. Keep it distinct from tenant tokens.
# SOVEREIGN_METRICS_TOKEN=replace-with-random-value

# Local dashboard binds only to 127.0.0.1:3000.
# SOVEREIGN_DASHBOARD_TENANT_TOKEN=the-same-token-as-your-local-demo-tenant
# SOVEREIGN_DASHBOARD_APPROVER_TOKEN=the-matching-separate-approver-token

# Offline parser is default and needs no key. To enable the OpenAI Responses parser,
# set all three values explicitly. A missing key/model leaves the parser offline.
SOVEREIGN_LLM_MODE=offline
# SOVEREIGN_LLM_MODEL=your-supported-model
# OPENAI_API_KEY=your-secret-key
# SOVEREIGN_LLM_ALLOWED_TENANTS=tenant-id

# TypeSafe/Jev advisory is disabled by default. Fixture is a deterministic
# local proxy, not a Jev response. Live mode requires all values and explicit
# tenant authorization for sanitized numeric state egress.
SOVEREIGN_JEV_MODE=disabled
# SOVEREIGN_JEV_MODEL=jev-version-from-your-account
# TYPESAFE_API_KEY=your-secret-key
# SOVEREIGN_JEV_ALLOWED_TENANTS=tenant-id
