[
  {
    "name": "gateway",
    "replicas": 1,
    "ready": 1,
    "strategy": {
      "type": "Recreate"
    },
    "pod_spec": {
      "containers": [
        {
          "env": [
            {
              "name": "BACKEND",
              "value": "kubernetes"
            }
          ],
          "image": "jointsla-gateway:42528cf0e863a510",
          "imagePullPolicy": "Never",
          "lifecycle": {
            "preStop": {
              "exec": {
                "command": [
                  "python",
                  "-c",
                  "import time; time.sleep(2)"
                ]
              }
            }
          },
          "livenessProbe": {
            "failureThreshold": 3,
            "httpGet": {
              "path": "/live",
              "port": 8090,
              "scheme": "HTTP"
            },
            "periodSeconds": 10,
            "successThreshold": 1,
            "timeoutSeconds": 2
          },
          "name": "gateway",
          "ports": [
            {
              "containerPort": 8090,
              "protocol": "TCP"
            }
          ],
          "readinessProbe": {
            "failureThreshold": 1,
            "httpGet": {
              "path": "/ready",
              "port": 8090,
              "scheme": "HTTP"
            },
            "periodSeconds": 2,
            "successThreshold": 1,
            "timeoutSeconds": 1
          },
          "resources": {
            "limits": {
              "cpu": "1",
              "memory": "512Mi"
            },
            "requests": {
              "cpu": "100m",
              "memory": "256Mi"
            }
          },
          "securityContext": {
            "allowPrivilegeEscalation": false,
            "capabilities": {
              "drop": [
                "ALL"
              ]
            },
            "readOnlyRootFilesystem": true
          },
          "startupProbe": {
            "failureThreshold": 150,
            "httpGet": {
              "path": "/live",
              "port": 8090,
              "scheme": "HTTP"
            },
            "periodSeconds": 2,
            "successThreshold": 1,
            "timeoutSeconds": 1
          },
          "terminationMessagePath": "/dev/termination-log",
          "terminationMessagePolicy": "File",
          "volumeMounts": [
            {
              "mountPath": "/tmp",
              "name": "tmp"
            }
          ]
        }
      ],
      "dnsPolicy": "ClusterFirst",
      "restartPolicy": "Always",
      "schedulerName": "default-scheduler",
      "securityContext": {
        "runAsGroup": 1000,
        "runAsNonRoot": true,
        "runAsUser": 1000,
        "seccompProfile": {
          "type": "RuntimeDefault"
        }
      },
      "serviceAccount": "jointsla-controller",
      "serviceAccountName": "jointsla-controller",
      "terminationGracePeriodSeconds": 75,
      "volumes": [
        {
          "emptyDir": {
            "sizeLimit": "128Mi"
          },
          "name": "tmp"
        }
      ]
    }
  },
  {
    "name": "grafana",
    "replicas": 1,
    "ready": 1,
    "strategy": {
      "type": "Recreate"
    },
    "pod_spec": {
      "automountServiceAccountToken": false,
      "containers": [
        {
          "env": [
            {
              "name": "GF_AUTH_ANONYMOUS_ENABLED",
              "value": "true"
            },
            {
              "name": "GF_AUTH_ANONYMOUS_ORG_ROLE",
              "value": "Viewer"
            },
            {
              "name": "GF_SECURITY_ADMIN_PASSWORD",
              "valueFrom": {
                "secretKeyRef": {
                  "key": "password",
                  "name": "grafana-admin"
                }
              }
            }
          ],
          "image": "grafana/grafana@sha256:6ac590e7cabc2fbe8d7b8fc1ce9c9f0582177b334e0df9c927ebd9670469440f",
          "imagePullPolicy": "IfNotPresent",
          "livenessProbe": {
            "failureThreshold": 3,
            "httpGet": {
              "path": "/api/health",
              "port": 3000,
              "scheme": "HTTP"
            },
            "periodSeconds": 10,
            "successThreshold": 1,
            "timeoutSeconds": 2
          },
          "name": "grafana",
          "ports": [
            {
              "containerPort": 3000,
              "protocol": "TCP"
            }
          ],
          "readinessProbe": {
            "failureThreshold": 1,
            "httpGet": {
              "path": "/api/health",
              "port": 3000,
              "scheme": "HTTP"
            },
            "periodSeconds": 2,
            "successThreshold": 1,
            "timeoutSeconds": 2
          },
          "resources": {
            "limits": {
              "cpu": "500m",
              "memory": "512Mi"
            },
            "requests": {
              "cpu": "100m",
              "memory": "128Mi"
            }
          },
          "securityContext": {
            "allowPrivilegeEscalation": false,
            "capabilities": {
              "drop": [
                "ALL"
              ]
            },
            "readOnlyRootFilesystem": true
          },
          "startupProbe": {
            "failureThreshold": 60,
            "httpGet": {
              "path": "/api/health",
              "port": 3000,
              "scheme": "HTTP"
            },
            "periodSeconds": 2,
            "successThreshold": 1,
            "timeoutSeconds": 1
          },
          "terminationMessagePath": "/dev/termination-log",
          "terminationMessagePolicy": "File",
          "volumeMounts": [
            {
              "mountPath": "/etc/grafana/provisioning/datasources",
              "name": "grafana-datasource",
              "readOnly": true
            },
            {
              "mountPath": "/etc/grafana/provisioning/dashboards",
              "name": "grafana-provider",
              "readOnly": true
            },
            {
              "mountPath": "/var/lib/grafana/dashboards",
              "name": "grafana-dashboard",
              "readOnly": true
            },
            {
              "mountPath": "/var/lib/grafana",
              "name": "data"
            },
            {
              "mountPath": "/tmp",
              "name": "tmp"
            }
          ]
        }
      ],
      "dnsPolicy": "ClusterFirst",
      "restartPolicy": "Always",
      "schedulerName": "default-scheduler",
      "securityContext": {
        "fsGroup": 472,
        "runAsGroup": 472,
        "runAsNonRoot": true,
        "runAsUser": 472,
        "seccompProfile": {
          "type": "RuntimeDefault"
        }
      },
      "terminationGracePeriodSeconds": 30,
      "volumes": [
        {
          "configMap": {
            "defaultMode": 420,
            "name": "grafana-datasource"
          },
          "name": "grafana-datasource"
        },
        {
          "configMap": {
            "defaultMode": 420,
            "name": "grafana-provider"
          },
          "name": "grafana-provider"
        },
        {
          "configMap": {
            "defaultMode": 420,
            "name": "grafana-dashboard"
          },
          "name": "grafana-dashboard"
        },
        {
          "name": "data",
          "persistentVolumeClaim": {
            "claimName": "grafana-data"
          }
        },
        {
          "emptyDir": {
            "sizeLimit": "128Mi"
          },
          "name": "tmp"
        }
      ]
    }
  },
  {
    "name": "inference",
    "replicas": 2,
    "ready": 2,
    "strategy": {
      "rollingUpdate": {
        "maxSurge": 1,
        "maxUnavailable": 0
      },
      "type": "RollingUpdate"
    },
    "pod_spec": {
      "automountServiceAccountToken": false,
      "containers": [
        {
          "env": [
            {
              "name": "PRETRAINED",
              "value": "true"
            },
            {
              "name": "DEVICE",
              "value": "cpu"
            }
          ],
          "image": "jointsla-inference:d0c55c05906c5dac",
          "imagePullPolicy": "Never",
          "lifecycle": {
            "preStop": {
              "exec": {
                "command": [
                  "python",
                  "-c",
                  "import time; time.sleep(2)"
                ]
              }
            }
          },
          "livenessProbe": {
            "failureThreshold": 3,
            "httpGet": {
              "path": "/live",
              "port": 8080,
              "scheme": "HTTP"
            },
            "periodSeconds": 10,
            "successThreshold": 1,
            "timeoutSeconds": 2
          },
          "name": "inference",
          "ports": [
            {
              "containerPort": 8080,
              "protocol": "TCP"
            }
          ],
          "readinessProbe": {
            "failureThreshold": 1,
            "httpGet": {
              "path": "/ready",
              "port": 8080,
              "scheme": "HTTP"
            },
            "periodSeconds": 2,
            "successThreshold": 1,
            "timeoutSeconds": 1
          },
          "resources": {
            "limits": {
              "cpu": "1",
              "memory": "2Gi"
            },
            "requests": {
              "cpu": "500m",
              "memory": "1Gi"
            }
          },
          "securityContext": {
            "allowPrivilegeEscalation": false,
            "capabilities": {
              "drop": [
                "ALL"
              ]
            },
            "readOnlyRootFilesystem": true
          },
          "startupProbe": {
            "failureThreshold": 150,
            "httpGet": {
              "path": "/live",
              "port": 8080,
              "scheme": "HTTP"
            },
            "periodSeconds": 2,
            "successThreshold": 1,
            "timeoutSeconds": 1
          },
          "terminationMessagePath": "/dev/termination-log",
          "terminationMessagePolicy": "File",
          "volumeMounts": [
            {
              "mountPath": "/tmp",
              "name": "tmp"
            }
          ]
        }
      ],
      "dnsPolicy": "ClusterFirst",
      "restartPolicy": "Always",
      "schedulerName": "default-scheduler",
      "securityContext": {
        "runAsGroup": 1000,
        "runAsNonRoot": true,
        "runAsUser": 1000,
        "seccompProfile": {
          "type": "RuntimeDefault"
        }
      },
      "terminationGracePeriodSeconds": 75,
      "volumes": [
        {
          "emptyDir": {
            "sizeLimit": "128Mi"
          },
          "name": "tmp"
        }
      ]
    }
  },
  {
    "name": "prometheus",
    "replicas": 1,
    "ready": 1,
    "strategy": {
      "type": "Recreate"
    },
    "pod_spec": {
      "automountServiceAccountToken": false,
      "containers": [
        {
          "args": [
            "--config.file=/etc/prometheus/prometheus.yml",
            "--storage.tsdb.path=/prometheus",
            "--storage.tsdb.retention.time=7d",
            "--storage.tsdb.retention.size=1500MB"
          ],
          "image": "prom/prometheus@sha256:63805ebb8d2b3920190daf1cb14a60871b16fd38bed42b857a3182bc621f4996",
          "imagePullPolicy": "IfNotPresent",
          "livenessProbe": {
            "failureThreshold": 3,
            "httpGet": {
              "path": "/-/healthy",
              "port": 9090,
              "scheme": "HTTP"
            },
            "periodSeconds": 10,
            "successThreshold": 1,
            "timeoutSeconds": 2
          },
          "name": "prometheus",
          "ports": [
            {
              "containerPort": 9090,
              "protocol": "TCP"
            }
          ],
          "readinessProbe": {
            "failureThreshold": 1,
            "httpGet": {
              "path": "/-/ready",
              "port": 9090,
              "scheme": "HTTP"
            },
            "periodSeconds": 2,
            "successThreshold": 1,
            "timeoutSeconds": 2
          },
          "resources": {
            "limits": {
              "cpu": "500m",
              "memory": "512Mi"
            },
            "requests": {
              "cpu": "100m",
              "memory": "128Mi"
            }
          },
          "securityContext": {
            "allowPrivilegeEscalation": false,
            "capabilities": {
              "drop": [
                "ALL"
              ]
            },
            "readOnlyRootFilesystem": true
          },
          "startupProbe": {
            "failureThreshold": 60,
            "httpGet": {
              "path": "/-/healthy",
              "port": 9090,
              "scheme": "HTTP"
            },
            "periodSeconds": 2,
            "successThreshold": 1,
            "timeoutSeconds": 1
          },
          "terminationMessagePath": "/dev/termination-log",
          "terminationMessagePolicy": "File",
          "volumeMounts": [
            {
              "mountPath": "/etc/prometheus",
              "name": "prometheus-config",
              "readOnly": true
            },
            {
              "mountPath": "/prometheus",
              "name": "data"
            },
            {
              "mountPath": "/tmp",
              "name": "tmp"
            }
          ]
        }
      ],
      "dnsPolicy": "ClusterFirst",
      "restartPolicy": "Always",
      "schedulerName": "default-scheduler",
      "securityContext": {
        "fsGroup": 65534,
        "runAsGroup": 65534,
        "runAsNonRoot": true,
        "runAsUser": 65534,
        "seccompProfile": {
          "type": "RuntimeDefault"
        }
      },
      "terminationGracePeriodSeconds": 30,
      "volumes": [
        {
          "configMap": {
            "defaultMode": 420,
            "name": "prometheus-config"
          },
          "name": "prometheus-config"
        },
        {
          "name": "data",
          "persistentVolumeClaim": {
            "claimName": "prometheus-data"
          }
        },
        {
          "emptyDir": {
            "sizeLimit": "128Mi"
          },
          "name": "tmp"
        }
      ]
    }
  }
]