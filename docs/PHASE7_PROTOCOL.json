    {"id": "action_efficient", "source": "OFFLINE_FIXTURE", "slo_weight": 1.0, "latency_weight": 0.1, "recovery_weight": 0.05, "failure_weight": 1.0, "action_cost": 0.25},
    {"id": "latency_sensitive", "source": "OFFLINE_FIXTURE", "slo_weight": 1.0, "latency_weight": 0.4, "recovery_weight": 0.1, "failure_weight": 1.0, "action_cost": 0.05}
  ],
  "selection": "highest_validation_simulated_slo_rate_then_lowest_action_rate_then_proposal_id",
