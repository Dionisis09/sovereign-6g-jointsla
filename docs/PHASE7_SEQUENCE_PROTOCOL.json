{
  "protocol_version": "phase7-sequence-v1",
  "registered_before_outcome_generation": true,
  "evidence": "SIMULATION_ONLY_CPU",
  "purpose": "Evaluate a masked sequential policy with delayed scale-out and persistent queue state",
  "scenario_families": ["steady", "ramp", "burst", "network", "capacity"],
  "seed_splits": {
    "train": [120, 159],
    "validation": [160, 179],
    "test": [180, 199]
  },
  "horizon_ticks": 12,
  "tick_seconds": 1,
  "actions": ["noop", "scale_out"],
  "scale_ready_after_ticks": 2,
  "scale_failure_probability": 0.05,
  "max_scale_attempts_per_episode": 1,
  "mask": "existing_JointSLA_current_state_gate_and_no_pending_or_prior_scale_attempt",
  "algorithm": "masked_linear_q_learning",
  "training_policy_seeds": [11, 23, 37],
  "epochs": 5,
  "learning_rate": 0.02,
  "discount": 0.9,
  "exploration_epsilon": 0.15,
  "features": ["bias", "queue/20", "arrival/100", "cycle/50", "network/100", "slo/200", "headroom/200", "tick/12", "replicas/2", "pending/2", "attempted"],
  "tick_reward": "1 - breach - 0.1*min(p95/slo,4) - 0.05*scale_attempt - 0.2*failed_scale_attempt",
  "baselines": ["noop", "sla_threshold_70ms", "jointsla_gate"],
  "selection": "validation_episode_any_breach_rate_then_action_rate_then_policy_seed",
  "bootstrap": {"unit": "paired_episode_seed", "draws": 2000, "seed": 2028, "confidence": 0.95},
  "promotion": {
    "requires": ["no_mask_violations", "test_breach_reduction_lower_95pct_above_zero", "test_action_rate_no_higher_than_jointsla", "manual_review"],
    "maximum_stage": "OFFLINE_REVIEW_CANDIDATE"
  }
}
